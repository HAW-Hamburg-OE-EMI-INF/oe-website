---
import "../../styles/global.css";
import { faculties } from "@oe/shared/data/faculty.ts";
import { getStudiengangPageIdsByFaculty } from "@oe/shared/data/studiengaenge.ts";
import StudiengangDetailPage from "@oe/shared/pages/StudiengangDetailPage.astro";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (() => {
  return getStudiengangPageIdsByFaculty("INF").map((id) => ({
    params: { id },
    props: { studiengangPageId: id },
  }));
}) satisfies GetStaticPaths;

const { studiengangPageId } = Astro.props;
---

<StudiengangDetailPage faculty={faculties.INF} studiengangPageId={studiengangPageId} />
