---
import InfoIcon from "../../assets/icons/info.svg";
import { studiengaengeByFaculty } from "../../data/studiengaenge";
import type { FacultyEntry } from "../../types/types";
import Card from "../card/card.astro";
import StudiengaengeBox from "./studiengaenge-box.astro";

interface Props {
  faculty: FacultyEntry;
}

const { faculty } = Astro.props as Props;
---

<Card heading="Wichtige Informationen" headingTrailingIcon={InfoIcon} variant="primary">
  <p class="text-primary-100 mb-6 text-base leading-relaxed sm:text-lg">
    Auf dieser Seite sind die Informationen für die Orientierungseinheit{" "}
    <strong>{faculty.short}</strong>¹ kurz vor Semesterbeginn zu finden.
  </p>

  <div class="space-y-4">
    <StudiengaengeBox
      studiengaenge={studiengaengeByFaculty[faculty.id]}
      title={`¹ Studiengänge der Fakultät ${faculty.name}:`}
    />
  </div>
</Card>
