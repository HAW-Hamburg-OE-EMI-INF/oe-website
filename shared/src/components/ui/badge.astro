---
export type BadgeVariant = "soft" | "solid" | "glass" | "mono";

export interface Props {
  variant?: BadgeVariant;
}

const { variant = "soft" } = Astro.props as Props;

const variantClasses: Record<BadgeVariant, string> = {
  soft: "bg-primary-100 text-primary-800 shrink-0 rounded px-2 py-0.5 text-xs font-bold tracking-wider uppercase",
  solid:
    "bg-primary-700 inline-flex shrink-0 items-center justify-center rounded-md px-2.5 py-1 text-xs font-bold tracking-wider text-white",
  glass:
    "bg-primary-500/50 border-primary-300/30 inline-flex shrink-0 items-center justify-center rounded-md border px-2.5 py-1 text-xs font-bold tracking-wider text-white",
  mono: "rounded border border-slate-200 bg-slate-100 px-1.5 py-0.5 font-mono text-xs font-semibold text-slate-800",
};
---

<span class:list={variantClasses[variant]}>
  <slot />
</span>
