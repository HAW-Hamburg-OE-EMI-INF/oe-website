---
import type { FacultyEntry } from "../../types/types";
import Link from "../ui/link.astro";

interface Props {
  faculty: FacultyEntry;
}

const { faculty } = Astro.props as Props;

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200 bg-white py-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-4 text-sm text-slate-500 md:flex-row">
      <div class="flex flex-wrap items-center gap-2 text-center md:text-left">
        <span class="font-semibold text-slate-700">OE HAW Hamburg</span>
        <span>&bull;</span>
        <span>
          &copy; {currentYear} OE-{faculty.short}
        </span>
      </div>

      <nav class="flex flex-wrap items-center justify-center gap-6">
        <Link href="/impressum" variant="subtle">
          Impressum
        </Link>
        <Link href="/datenschutz" variant="subtle">
          Datenschutzerklärung
        </Link>
        <Link external href="https://www.instagram.com/oe_emi_inf" variant="subtle">
          Instagram
        </Link>
      </nav>
    </div>
  </div>
</footer>
