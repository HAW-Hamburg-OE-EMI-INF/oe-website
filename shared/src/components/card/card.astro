---
import type { SvgComponent } from "astro/types";

export type CardElement = "div" | "nav" | "article" | "section";
export type CardVariant = "white" | "primary";
export type CardPadding = "sm" | "md" | "lg";

export interface Props {
  as?: CardElement;
  variant?: CardVariant;
  padding?: CardPadding;
  heading?: string;
  headingTrailingIcon?: SvgComponent;
  ariaLabel?: string;
  class?: string;
}

const {
  as = "div",
  variant = "white",
  padding = "md",
  heading,
  headingTrailingIcon: HeadingTrailingIcon,
  ariaLabel,
  class: className = "",
} = Astro.props as Props;

const Tag = as;

const variantClasses: Record<CardVariant, string> = {
  white: "bg-white border border-slate-200 shadow-xs text-slate-900",
  primary: "bg-primary-700 text-white shadow-md",
};

const paddingClasses: Record<CardPadding, string> = {
  sm: "p-4 sm:p-5",
  md: "p-6 sm:p-8",
  lg: "p-6 sm:p-10",
};
---

<Tag
  aria-label={ariaLabel}
  class:list={["rounded-2xl", paddingClasses[padding], variantClasses[variant], className]}
>
  {(heading || HeadingTrailingIcon) && (
    <div class="mb-4 flex items-center gap-3">
      {HeadingTrailingIcon && (
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white/15 text-white">
          <HeadingTrailingIcon class="h-6 w-6" />
        </div>
      )}
      {heading && <h2 class="text-2xl font-bold">{heading}</h2>}
    </div>
  )}
  <slot />
</Tag>
