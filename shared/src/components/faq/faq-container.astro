---
import Card from "../card/card.astro";
import Badge from "../ui/badge.astro";

const content = await Astro.slots.render("default");

const sectionParts = content.split("<section");
const categories = sectionParts
  .filter((part) => part.includes('data-category-id="'))
  .map((part) => {
    const id = part.split('data-category-id="')[1]?.split('"')[0] ?? "";
    const rawTitle = part.split('data-category-title="')[1]?.split('"')[0] ?? "";
    const title = rawTitle.replaceAll("&amp;", "&");
    const countStr = part.split('data-category-count="')[1]?.split('"')[0] ?? "0";
    return { id, title, count: Number.parseInt(countStr, 10) || 0 };
  });
---

{categories.length > 0 && (
  <Card ariaLabel="Themenauswahl" as="nav" padding="sm" variant="white">
    <p class="text-primary-700 mb-3 text-xs font-semibold tracking-wider uppercase">
      Themenübersicht
    </p>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-3">
      {categories.map((category) => (
        <a
          class="hover:bg-primary-50 hover:border-primary-300 group flex min-w-0 items-center gap-3 rounded-xl border border-slate-200/80 bg-slate-50 p-3.5 transition-all duration-200 sm:last:col-span-2 md:last:col-span-1"
          href={`#${category.id}`}
        >
          <Badge variant="solid">{category.count}</Badge>
          <span class="group-hover:text-primary-700 min-w-0 text-xs leading-snug font-semibold text-slate-800 transition-colors sm:text-sm">
            {category.title}
          </span>
        </a>
      ))}
    </div>
  </Card>
)}

<slot />
