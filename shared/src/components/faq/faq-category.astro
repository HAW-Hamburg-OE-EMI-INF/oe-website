---
import SectionHeader from "../ui/section-header.astro";

interface Props {
  title: string;
  description?: string;
  type: string;
}

const { title, description, type: categoryId } = Astro.props as Props;

const content = await Astro.slots.render("default");
const questionCount = Math.max(0, content.split("data-faq-item").length - 1);
---

<section
  class="scroll-mt-20 space-y-4"
  data-category-count={questionCount}
  data-category-id={categoryId}
  data-category-title={title}
  id={categoryId}
>
  <SectionHeader
    badge={`${questionCount}\u00A0${questionCount === 1 ? "Frage" : "Fragen"}`}
    description={description}
    title={title}
  />

  <div class="space-y-3">
    <slot />
  </div>
</section>
