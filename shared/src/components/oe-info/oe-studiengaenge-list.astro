---
import type { StudiengangEntry } from "../../types/types";
import { getGermanListSeparator } from "../../util/format.util";

export interface Props {
  studiengaenge: StudiengangEntry[];
}

const { studiengaenge } = Astro.props as Props;
---

{studiengaenge.map((item, index) => (
  <>
    <strong class="text-primary-800 font-bold">
      {item.name} ({item.short})
    </strong>
    {getGermanListSeparator(index, studiengaenge.length)}
  </>
))}
