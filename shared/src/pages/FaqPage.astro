---
import FAQContainer from "../components/faq/faq-container.astro";
import Hero from "../components/hero/hero.astro";
import FAQContent from "../data/faq-content.astro";
import Layout from "../layouts/Layout.astro";
import type { FacultyEntry } from "../types/types";

import "../styles/faq.css";

interface Props {
  faculty: FacultyEntry;
}

const { faculty } = Astro.props as Props;
---

<Layout faculty={faculty} name="Häufig gestellte Fragen (FAQ)">
  <Hero
    compact
    slot="hero"
    subtitle="Antworten auf die wichtigsten Fragen zur Orientierungseinheit und deinem Studienstart an der HAW Hamburg"
    title="Häufige Fragen (FAQ)"
  />

  <FAQContainer>
    <FAQContent />
  </FAQContainer>
</Layout>
