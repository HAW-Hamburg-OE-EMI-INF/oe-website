---
import Hero from "../components/hero/hero.astro";
import StudiengangCard from "../components/studiengang/studiengang-card.astro";
import Layout from "../layouts/Layout.astro";
import type { FacultyEntry, StudiengangEntry } from "../types/types";

interface Props {
  faculty: FacultyEntry;
  studiengaenge: StudiengangEntry[];
}

const { faculty, studiengaenge: entries } = Astro.props as Props;
---

<Layout faculty={faculty} name="Studiengänge">
  <Hero compact slot="hero" title="Studiengänge" />

  <div class="border-b border-slate-200 pb-2">
    <div class="flex items-center gap-2">
      <span class="bg-primary-100 text-primary-800 rounded px-2 py-0.5 text-xs font-bold tracking-wider uppercase">
        {faculty.short}
      </span>
      <h2 class="text-lg font-bold text-slate-900">Fakultät {faculty.name}</h2>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {entries.map((studiengang) => (
      <StudiengangCard studiengang={studiengang} />
    ))}
  </div>
</Layout>
