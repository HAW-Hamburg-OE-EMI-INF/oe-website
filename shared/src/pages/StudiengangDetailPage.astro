---
import Card from "../components/card/card.astro";
import Hero from "../components/hero/hero.astro";
import RoadmapCard from "../components/roadmap/roadmap-card.astro";
import { linksByPage } from "../data/links";
import { roadmapBuilderDataByPageId } from "../data/roadmap";
import { studiengaengeByPage } from "../data/studiengaenge";
import { tutorNames } from "../data/tutor-names";
import Layout from "../layouts/Layout.astro";
import type { FacultyEntry, StudiengangPageId } from "../types/types";
import { roadmapBuilder } from "../util/roadmap.util";

export interface Props {
  faculty: FacultyEntry;
  studiengangPageId: StudiengangPageId;
}

const { studiengangPageId, faculty } = Astro.props as Props;

function formatTutors(list: string[]): string {
  if (!list || list.length === 0) return "";

  const sorted = [...list].sort();

  if (sorted.length === 1) return sorted[0];
  if (sorted.length === 2) return `${sorted[0]} und ${sorted[1]}`;
  return `${sorted.slice(0, -1).join(", ")} und ${sorted[sorted.length - 1]}`;
}

const formattedTutors = formatTutors(tutorNames[studiengangPageId]);

const studiengaenge = studiengaengeByPage[studiengangPageId];

const studiengangNames = studiengaenge.map((s) => s.name).join(" und ");
const tutorTitle = studiengaenge.map((s) => s.short).join("- und ");

const pageTitleName = studiengaenge.map((s) => `${s.name} (${s.short})`).join(" | ");

const links = linksByPage[studiengangPageId];

const roadmapData =
  studiengangPageId !== "m-inf"
    ? roadmapBuilder(roadmapBuilderDataByPageId[studiengangPageId])
    : null;
---

<Layout faculty={faculty} name={pageTitleName}>
  <Hero
    compact
    slot="hero"
    subtitle={`Fakultät ${studiengaenge[0].faculty.name}`}
    title={studiengangNames}
  />

  <Card heading=`Eure ${tutorTitle}-Tutor*innen` variant="white">
    <p class="text-base leading-relaxed text-slate-700">
      {formattedTutors || "Die Tutor*innen für diesen Studiengang werden noch bekanntgegeben."}
    </p>
  </Card>

  {roadmapData && <RoadmapCard data={roadmapData} />}

  <Card heading="Linksammlung" variant="white">
    <ul class="list-disc space-y-3 pl-5">
      {links.map((link) => (
        <li class="leading-relaxed">
          <div>
            <a
              class="text-primary-600 hover:text-primary-800 inline-block font-medium hover:underline"
              href={link.href}
              rel="noreferrer noopener"
              target="_blank"
            >
              {link.label}
            </a>{" "}
            {link.teamsCode && (
              <span class="rounded border border-slate-200 bg-slate-100 px-1.5 py-0.5 font-mono text-xs font-semibold text-slate-800">
                Teams&#x2011;Code:&nbsp;{link.teamsCode}
              </span>
            )}
          </div>
          {link.note && <span class="mt-0.5 text-sm text-slate-600">{link.note}</span>}
        </li>
      ))}
    </ul>
  </Card>
</Layout>
