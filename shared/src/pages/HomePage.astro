---
import CampusImage from "../assets/background/Campus-Berliner-Tor-2018.webp";
import FacultyTiles from "../components/hero/faculty-tiles.astro";
import Hero from "../components/hero/hero.astro";
import OeInfoCard from "../components/oe-info/oe-info-card.astro";
import RoadmapCard from "../components/roadmap/roadmap-card.astro";
import SponsorCard from "../components/sponsor/sponsor-card.astro";
import Wartungsarbeiten from "../components/wartungsarbeiten/wartungsarbeiten.astro";
import { oeInfoCardDataEMI, oeInfoCardDataINF } from "../data/general-info";
import { roadmapBuilderDataByPageId } from "../data/roadmap";
import Layout from "../layouts/Layout.astro";
import type { FacultyEntry, RoadmapData, StudiengangPageId } from "../types/types";
import { roadmapBuilder } from "../util/roadmap.util";

interface Props {
  faculty: FacultyEntry;
  roadmapStudiengangPageIds: Exclude<StudiengangPageId, "m-inf">[];
}

const { faculty, roadmapStudiengangPageIds } = Astro.props as Props;

const roadmapData: RoadmapData[] = roadmapStudiengangPageIds.map((data) =>
  roadmapBuilder(roadmapBuilderDataByPageId[data]),
);
---

<Layout faculty={faculty} name="Start">
  <Hero
    backgroundImage={CampusImage}
    imageAlt="HAW Hamburg Campus Berliner Tor"
    subtitle="Herzlich Willkommen an der HAW Hamburg zum Studienstart an der Fakultät"
    title="Orientierungseinheit"
  >
    <FacultyTiles faculties={[faculty]} />
  </Hero>

  <div class="mx-auto w-full max-w-4xl space-y-8 px-4 py-10 sm:px-6">
    <Wartungsarbeiten faculty={faculty} />

    {faculty.id === "INF" && <OeInfoCard data={oeInfoCardDataINF} />}
    {faculty.id === "EMI" && <OeInfoCard data={oeInfoCardDataEMI} />}

    {roadmapData.map((data) => (
      <RoadmapCard data={data} />
    ))}
    <SponsorCard />
  </div>
</Layout>
