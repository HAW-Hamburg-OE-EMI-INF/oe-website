{
  "name": "haw-hamburg-oe-emi-inf-website",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "shared",
    "emi",
    "inf"
  ],
  "type": "module",
  "scripts": {
    "dev:emi": "npm run dev --workspace=@oe/emi",
    "dev:inf": "npm run dev --workspace=@oe/inf",
    "build": "npm run build --workspaces --if-present",
    "build:emi": "npm run build --workspace=@oe/emi",
    "build:inf": "npm run build --workspace=@oe/inf",
    "preview:emi": "npm run preview --workspace=@oe/emi",
    "preview:inf": "npm run preview --workspace=@oe/inf",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "oxfmt": "^0.77.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "allowScripts": {
    "fsevents": true
  }
}
